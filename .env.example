# ==========================================
# Variables de Entorno - Terra Viva
# ==========================================
# Copia este archivo a .env.local y completa los valores
# NUNCA subas .env.local a Git (ya está en .gitignore)

# ==========================================
# SUPABASE - Base de datos PostgreSQL
# ==========================================
# 1. Crea cuenta gratis en https://supabase.com
# 2. Crea un nuevo proyecto
# 3. Ve a Settings > API
# 4. Copia la URL y la anon/public key

VITE_SUPABASE_URL=https://tuproyecto.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ==========================================
# GEMINI API - Chatbot IA
# ==========================================
# 1. Ve a https://aistudio.google.com/app/apikey
# 2. Crea una nueva API Key

VITE_GEMINI_API_KEY=AIzaSy...

# ==========================================
# IMGBB - Hosting de Imágenes (Opcional)
# ==========================================
# 1. Crea cuenta gratis en https://imgbb.com
# 2. Ve a https://api.imgbb.com/
# 3. Copia tu API Key

VITE_IMGBB_API_KEY=dcabe32a20a25cd60fbbdb29f095bd62

# ==========================================
# CERTIFICADO SSL (Conexiones directas)
# ==========================================
# El certificado prod-ca-2021 está incluido en:
# certificates/prod-ca-2021.crt
#
# Para conexiones directas a PostgreSQL (psql, DBeaver):
# Settings > Database > SSL Configuration > Download Certificate
#
# Conexión segura:
# psql "sslmode=verify-full sslrootcert=./prod-ca-2021.crt host=db.tuproyecto.supabase.co"

# ==========================================
# NOTAS IMPORTANTES
# ==========================================
# - En Vercel: Settings > Environment Variables
# - En Netlify: Site Settings > Environment Variables
# - Las variables con VITE_ son accesibles desde el frontend
# - Supabase usa TLS 1.2+ para todas las conexiones
# - El certificado SSL está en: certificates/prod-ca-2021.crt
